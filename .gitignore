[Ll]ogs/
[Mm]emoryCaptures/
# Unity build output folders committed by mistake upstream
Release/
Standalone/
# Build output copied in by the MSBuild post-build step (regenerated on build)
UnityProject/Assets/Plugins/*.dll
UnityProject/Assets/Plugins/*.pdb
# Unity user-specific settings
UnityProject/UserSettings/
# Unity-generated project files (scoped — keep Source/*.csproj / *.sln)
UnityProject/*.csproj
UnityProject/*.unityproj
UnityProject/*.sln
UnityProject/**/*.csproj
UnityProject/**/*.sln
*.unityproj
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.opendb
*.VC.db
# Explicit: ship the .NET solution/project under Source/
!Source/*.csproj
!Source/*.sln
# Unity-generated FBX embedded texture folders (regenerated on reimport)
*.fbm/
# Unity crash recovery
Assets/_Recovery/
# TextMesh Pro demo content (not shipped; reimport from the package if needed)
Assets/TextMesh Pro/Examples & Extras/
# Autogenerated VS/MD solution and project files
ExportedObj/
.consulo/
*.pidb.meta
*.pdb.meta
*.mdb.meta

# .NET
bin/
obj/
.vs/
TestResults/
*.user
*.suo
*.userosscache
*.sln.docstates
